      "item": [
        {
          "name": "richiesta-lotto-nre",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let response = pm.response.json();\r",
                  "if (response.codEsito==\"0000\") {\r",
                  "    let codRegione = response.codRegione;\r",
                  "    let codRagLotto = response.codRagLotto;\r",
                  "    let identificativoLotto = response.identificativoLotto;\r",
                  "    let codLotto = response.codLotto;\r",
                  "    let lottoNre = codRegione + codRagLotto + identificativoLotto + codLotto;\r",
                  "    pm.collectionVariables.set('lottoNre', lottoNre);\r",
                  "    pm.collectionVariables.set('contatoreLottoNre', 0);\r",
                  "    if (lottoNre.length==12) {\r",
                  "        pm.collectionVariables.set('dimensioneLottoNre', 1000);\r",
                  "    } else if (lottoNre.length==13) {\r",
                  "        pm.collectionVariables.set('dimensioneLottoNre', 100);\r",
                  "    }\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth-token}}",
                "type": "text"
              },
              {
                "key": "FSE-JWT-Signature",
                "value": "{{signature-token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"CodRegione\": \"{{codRegione}}\",\n    \"IdentificativoLotto\": \"0\",\n    \"CFMedico\": \"{{cfMedico}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/v1/servizi-prescrittore/richiesta-lotto-nre",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "v1",
                "servizi-prescrittore",
                "richiesta-lotto-nre"
              ]
            }
          },
          "response": []
        },
