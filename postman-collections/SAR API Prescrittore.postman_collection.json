                  "    contatoreLottoNre++;\r",
                  "    pm.collectionVariables.set('contatoreLottoNre', contatoreLottoNre);\r",
                  "    if (contatoreLottoNre > maxNre) {\r",
                  "        console.warn(\"Lotto NRE terminato, richiedere un nuovo lotto!\");\r",
                  "    }\r",
                  "}"
