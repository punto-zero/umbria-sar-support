        {
          "name": "dem-invio-prescritto farmaceutica",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "let lottoNre = pm.collectionVariables.get('lottoNre');\r",
                  "if (lottoNre == undefined || lottoNre == null || lottoNre == \"\") {\r",
                  "    console.error(\"Lotto NRE non disponibile, richiedere un nuovo lotto!\");\r",
                  "    throw new Error(\"Lotto NRE non disponibile, richiedere un nuovo lotto!\");\r",
                  "}\r",
                  "let dimensioneLottoNre =  pm.collectionVariables.get(\"dimensioneLottoNre\");\r",
                  "let maxNre = dimensioneLottoNre - 1;\r",
                  "let contatoreLottoNre = pm.collectionVariables.get(\"contatoreLottoNre\");\r",
                  "if (contatoreLottoNre > maxNre) {\r",
                  "    console.error(\"Lotto NRE terminato, richiedere un nuovo lotto!\");\r",
                  "    throw new Error(\"Lotto NRE terminato, richiedere un nuovo lotto!\");\r",
                  "}\r",
                  "let nre = lottoNre + String(contatoreLottoNre).padStart(String(maxNre).length, '0');\r",
                  "pm.collectionVariables.set('nre', nre);\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let response = pm.response.json();\r",
                  "if (response.codEsitoInserimento==\"0000\" || response.codEsitoInserimento==\"0001\") {\r",
                  "    let nre = response.nre;\r",
                  "    pm.collectionVariables.set('nre', nre);\r",
                  "\r",
                  "    let contatoreLottoNre = pm.collectionVariables.get(\"contatoreLottoNre\");\r",
                  "    contatoreLottoNre++;\r",
                  "    pm.collectionVariables.set('contatoreLottoNre', contatoreLottoNre);\r",
                  "    if (contatoreLottoNre > maxNre) {\r",
                  "        console.warn(\"Lotto NRE terminato, richiedere un nuovo lotto!\");\r",
                  "    }\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
